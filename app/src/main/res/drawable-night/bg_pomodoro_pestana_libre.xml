<?xml version="1.0" encoding="utf-8"?>

<!--
    Pestana "suelta": se usa mientras se esta arrastrando, cuando ya no esta
    pegada a ningun borde. Por eso tiene las cuatro esquinas redondeadas
    (36dp = mitad de su ancho de 72dp) en lugar del canto recto del borde.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:startColor="#7C3AED"
        android:endColor="#4F46E5" />

    <corners
        android:radius="36dp" />

</shape>