<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#252037" android:centerColor="#2B2540" android:endColor="#243244" />
            <corners android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp" />
        </shape>
    </item>
    <item android:width="190dp" android:height="190dp" android:gravity="top|end" android:right="-35dp" android:top="-70dp">
        <shape android:shape="oval"><gradient android:angle="45" android:startColor="#24A78BFA" android:endColor="#00A78BFA" /></shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="top|start" android:left="-40dp" android:top="30dp">
        <shape android:shape="oval"><gradient android:angle="45" android:startColor="#2093C5FD" android:endColor="#0093C5FD" /></shape>
    </item>
    <item android:width="160dp" android:height="90dp" android:gravity="bottom|end" android:right="12dp" android:bottom="-20dp">
        <shape android:shape="oval"><gradient android:angle="45" android:startColor="#18F9A8D4" android:endColor="#00F9A8D4" /></shape>
    </item>
</layer-list>
