<?xml version="1.0" encoding="utf-8"?>

<!--
    Pestana pegada al borde izquierdo: el canto recto queda a la izquierda
    (el que toca el borde de la pantalla) y el redondeado a la derecha.
    El gradiente va invertido respecto del lado derecho para que el color
    claro quede siempre en el extremo que mira a la pantalla.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="90"
        android:startColor="#7C3AED"
        android:endColor="#4F46E5" />

    <corners
        android:topLeftRadius="0dp"
        android:bottomLeftRadius="0dp"
        android:topRightRadius="24dp"
        android:bottomRightRadius="24dp" />

</shape>