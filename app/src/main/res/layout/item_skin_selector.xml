<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="128dp"
    android:background="@drawable/bg_selector_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="7dp">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_pet_selector_circle">

        <ImageView
            android:id="@+id/ivSkinOpcion"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:contentDescription="Apariencia de mascota"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvNombreSkin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/app_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>