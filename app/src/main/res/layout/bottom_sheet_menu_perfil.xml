<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalización"
        android:textColor="#211D3B"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Administra tu perfil y tu compañero"
        android:textColor="#8B88A8"
        android:textSize="12sp" />

    <!-- EDITAR PERFIL -->

    <LinearLayout
        android:id="@+id/opcionEditarPerfil"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_menu_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_menu_icon_purple"
            android:gravity="center"
            android:text="👤"
            android:textSize="21sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar perfil"
                android:textColor="#2D2942"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cambia tu avatar y tu nombre"
                android:textColor="#918DA4"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#AAA6B9"
            android:textSize="28sp" />

    </LinearLayout>

    <!-- PERSONALIZAR MASCOTA -->

    <LinearLayout
        android:id="@+id/opcionPersonalizarMascota"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_menu_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_menu_icon_blue"
            android:gravity="center"
            android:text="🐱"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personalizar mascota"
                android:textColor="#2D2942"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Elige su apariencia"
                android:textColor="#918DA4"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#AAA6B9"
            android:textSize="28sp" />

    </LinearLayout>

    <!-- NOMBRE MASCOTA -->

    <LinearLayout
        android:id="@+id/opcionNombreMascota"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_menu_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_menu_icon_orange"
            android:gravity="center"
            android:text="⚙️"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuracion"
                android:textColor="#2D2942"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Configuracion general de la aplicacion"
                android:textColor="#918DA4"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#AAA6B9"
            android:textSize="28sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="9dp"
        android:background="#EEEAF5" />

    <!-- CERRAR SESIÓN -->

    <LinearLayout
        android:id="@+id/opcionCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/bg_menu_logout"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_menu_icon_red"
            android:gravity="center"
            android:text="↪"
            android:textColor="#EF4444"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Cerrar sesión"
            android:textColor="#DC3F4F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#EBA0A8"
            android:textSize="28sp" />

    </LinearLayout>

</LinearLayout>