<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tituloCentroLector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lector_centro"
        android:textColor="@color/app_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/lector_centro_subtitulo"
        android:textColor="@color/app_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/favoritoLector"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/lector_favorito_accion"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/lector_favorito"
        android:textAllCaps="false"
        android:textColor="@color/app_primary_ui"
        android:textSize="13sp"
        app:icon="@drawable/ic_guia_star"
        app:iconSize="18dp"
        app:iconTint="@color/app_primary_ui" />

    <TextView
        android:id="@+id/avancePracticasLector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/app_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresoPracticasLector"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="3"
        app:indicatorColor="@color/app_primary_ui"
        app:trackColor="@color/app_primary_soft"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="6dp"
        android:text="@string/lector_practicas_ayuda"
        android:textColor="@color/app_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
