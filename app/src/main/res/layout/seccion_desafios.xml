<?xml version="1.0" encoding="utf-8"?>
<!--
    Sección DESAFÍOS del dashboard.

    Replica el lenguaje visual del bloque Explorar (cabecera de 19sp #211D3B
    y tarjeta blanca de 24dp con trazo #EEEAF8). Tiene dos estados que
    MainActivity alterna: pregunta (3 botones A/B/C) y resultado (feedback
    verde/rojo con justificación y recompensa).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_orange"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="38dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#EEEAF8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_desafios" />

                <!-- CABECERA DE LA TARJETA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/desafio_titulo_carta"
                            android:textColor="#211D3B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDesafioRacha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#6C5CE7"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- LA PREGUNTA -->
                <TextView
                    android:id="@+id/tvDesafioPregunta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#211D3B"
                    android:textSize="15sp" />

                <!-- OPCIONES A / B / C -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDesafioA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#211D3B"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#6C5CE7"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDesafioB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#211D3B"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#6C5CE7"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDesafioC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#211D3B"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#6C5CE7"
                    app:strokeWidth="1dp" />

                <!-- RESULTADO (se muestra al responder o si ya jugó hoy) -->
                <LinearLayout
                    android:id="@+id/contenedorDesafioResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvDesafioResultadoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDesafioResultadoSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#77738F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDesafioCorrecta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#211D3B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDesafioJustificacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#77738F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDesafioRecompensa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="#6C5CE7"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDesafioVuelve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/desafio_vuelve"
                        android:textColor="#8B88A8"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>