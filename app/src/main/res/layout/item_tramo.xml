<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Conector de puntos hacia el nodo anterior -->
    <ImageView
        android:id="@+id/ivConector"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:src="@drawable/conn_dl" />

    <!-- Nodo + tarjeta (se desplaza a izquierda/derecha por código) -->
    <LinearLayout
        android:id="@+id/contenedorNodo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmoji"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/nodo_actual"
            android:elevation="10dp"
            android:gravity="center"
            android:textSize="32sp"
            tools:text="🧠" />

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_full"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#1E1B4B"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Tramo 1" />

            <TextView
                android:id="@+id/tvTema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#6B7280"
                android:textSize="13sp"
                tools:text="Semiología" />

            <TextView
                android:id="@+id/tvEstrellas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F59E0B"
                android:textSize="16sp"
                tools:text="★★☆" />

            <TextView
                android:id="@+id/tvContenido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="#6B7280"
                android:textSize="11sp"
                tools:text="10 preguntas" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="170dp"
                android:textColor="#4F46E5"
                android:textSize="11sp"
                tools:text="Disponible" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTramo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button"
                android:minWidth="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Empezar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>