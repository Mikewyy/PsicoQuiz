<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:background="@drawable/bg_learning_card"
    android:paddingTop="18dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/tvTituloDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:gravity="left"
        android:text="Cambiar Correo"
        android:textColor="#211D3B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="15dp"
        android:text="Utiliza este menú para cambiar el correo electronico"
        android:textColor="#8B88A8"
        android:textSize="12sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_moderno"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTRASEÑA ACTUAL"
            android:textColor="#6C5CE7"
            android:textSize="9sp"
            android:textStyle="bold" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

        <EditText
            android:id="@+id/etCorreoActual"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_toStartOf="@+id/ivToggleActual"
            android:background="@android:color/transparent"
            android:hint="Tu contraseña actual"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#211D3B"
            android:textColorHint="#B0ACBD"
            android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivToggleActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_ojo_cerrado" />


        </RelativeLayout>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_moderno"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUEVO CORREO"
            android:textColor="#6C5CE7"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreoNuevo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:hint="nuevo@correo.com"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#211D3B"
            android:textColorHint="#B0ACBD"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_moderno"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRMAR NUEVO CORREO"
            android:textColor="#6C5CE7"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreoConfirmar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:hint="Repite el nuevo correo"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#211D3B"
            android:textColorHint="#B0ACBD"
            android:textSize="15sp" />

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelarCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:padding="10dp"
            android:text="Cancelar"
            android:textColor="#6C5CE7"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAceptarCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aceptar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#6C5CE7"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>