<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:background="@drawable/bg_dialog_competidor_card">
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:padding="14dp"
            android:background="@drawable/bg_dialog_competidor_logo_wrap">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Logo de Patotective"
                android:src="@drawable/logo_patotective" />
        </FrameLayout>
        <TextView
            android:id="@+id/tvTituloSalidaMultijugador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="¿Abandonar la partida?"
            android:gravity="center"
            android:textColor="@color/dialog_competidor_title"
            android:textStyle="bold"
            android:textSize="23sp" />
        <TextView
            android:id="@+id/tvMensajeSalidaMultijugador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="¿Quieres volver al multijugador?"
            android:textColor="@color/dialog_competidor_body"
            android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarSalidaMultijugador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="52dp"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="@color/dialog_competidor_button_text"
            android:textStyle="bold"
            app:backgroundTint="@color/dialog_competidor_button_bg"
            app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarSalidaMultijugador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/dialog_competidor_title"
            app:backgroundTint="@color/dialog_competidor_card"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
