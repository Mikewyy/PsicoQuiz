<?xml version="1.0" encoding="utf-8"?>

<!--
    Raiz vertical: el scroll lleva weight=1 y la barra de navegacion se queda
    pegada abajo. El fondo #F4F3FF sigue en el scroll, asi la barra blanca no
    deja costura contra el contenido.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F4F3FF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- =====================================================
                 CABECERA MORADA
                 ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#6C5CE7"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- Barra superior -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnVolver"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_boton_volver_guia"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guía de estudio"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Elige un camino para comenzar"
                            android:textColor="#E5E0FF"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="📖"
                        android:textSize="27sp" />

                </LinearLayout>


                <!-- =================================================
                     PROGRESO GENERAL
                     ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tu progreso general"
                                    android:textColor="#29263A"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvResumenProgreso"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="0 de 22 temas completados"
                                    android:textColor="#777386"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvProgresoGeneral"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#6C5CE7"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/barProgresoGeneral"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="15dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="#6C5CE7"
                            app:trackColor="#EAE7F8"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- =====================================================
                 CONTENIDO
                 ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="24dp"
                android:paddingEnd="18dp"
                android:paddingBottom="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Caminos de estudio"
                    android:textColor="#29263A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Selecciona el contenido que deseas estudiar"
                    android:textColor="#777386"
                    android:textSize="13sp" />


                <!-- =================================================
                     CAMINO 1: SÍNTOMAS Y FUNCIONES
                     ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSintomas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E3DFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Icono, título y flecha -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:background="@drawable/bg_numero_seccion"
                                android:gravity="center"
                                android:text="🧠"
                                android:textSize="29sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Síntomas y funciones"
                                    android:textColor="#29263A"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Semiología de los procesos y funciones psicológicas"
                                    android:textColor="#777386"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="›"
                                android:textColor="#6C5CE7"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- Etiquetas -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_etiqueta_suave"
                                android:paddingStart="12dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="7dp"
                                android:text="15 temas"
                                android:textColor="#625E70"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_recompensa"
                                android:paddingStart="12dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="7dp"
                                android:text="Camino principal"
                                android:textColor="#6C5CE7"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- Progreso síntomas -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvResumenSintomas"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0 de 15 temas completados"
                                android:textColor="#777386"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProgresoSintomas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#6C5CE7"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/barProgresoSintomas"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="9dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="#6C5CE7"
                            app:trackColor="#EAE7F8"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =================================================
                     CAMINO 2: SÍNDROMES
                     ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSindromes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E3DFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Icono, título y flecha -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:background="@drawable/bg_numero_seccion"
                                android:gravity="center"
                                android:text="🩺"
                                android:textSize="28sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Síndromes"
                                    android:textColor="#29263A"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Principales síndromes psicopatológicos"
                                    android:textColor="#777386"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="›"
                                android:textColor="#6C5CE7"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- Etiquetas -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_etiqueta_suave"
                                android:paddingStart="12dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="7dp"
                                android:text="7 temas"
                                android:textColor="#625E70"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_recompensa"
                                android:paddingStart="12dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="7dp"
                                android:text="Repaso clínico"
                                android:textColor="#6C5CE7"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- Progreso síndromes -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvResumenSindromes"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0 de 7 temas completados"
                                android:textColor="#777386"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProgresoSindromes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#6C5CE7"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/barProgresoSindromes"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="9dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="#6C5CE7"
                            app:trackColor="#EAE7F8"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMultijugador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#D7D2FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:background="@drawable/bg_numero_seccion"
                                android:gravity="center"
                                android:text="👥"
                                android:textSize="28sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Multijugador"
                                    android:textColor="#29263A"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Crea una sala o únete con un código para estudiar con otros"
                                    android:textColor="#777386"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="›"
                                android:textColor="#6C5CE7"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <!-- =================================================
                     RECOMPENSAS
                     ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#EEEAFE"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="🍪"
                            android:textSize="25sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estudia y consigue recompensas"
                                android:textColor="#423A78"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Completa temas para ganar comida para tu mascota."
                                android:textColor="#6C648E"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
