<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login">

    <!-- Burbujas de decoración de fondo -->
    <View
        android:layout_width="195dp"
        android:layout_height="195dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-55dp"
        android:background="@drawable/bg_login_bubble" />

    <View
        android:layout_width="145dp"
        android:layout_height="145dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="-85dp"
        android:background="@drawable/bg_login_bubble" />

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-85dp"
        android:background="@drawable/bg_login_bubble" />

    <!-- Contenido: estático en reposo, desplazable solo al abrir el teclado -->
    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="15dp">

        <ImageView
            android:id="@+id/imgMascota"
            android:layout_width="245dp"
            android:layout_height="245dp"
            android:contentDescription="@string/login_mascota_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/img_iniciar_sesion" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/login_marca_psico"
                android:textColor="@color/auth_text_on_gradient"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/login_marca_quiz"
                android:textColor="@color/auth_brand_quiz"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginEnd="54dp"
            android:layout_marginBottom="15dp"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/login_eslogan"
            android:textColor="@color/auth_text_on_gradient"
            android:textSize="13sp" />

        <!-- Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_card"
            android:elevation="7dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/login_form_titulo"
                android:textColor="@color/auth_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_form_subtitulo"
                android:textColor="@color/auth_text_secondary"
                android:textSize="12sp" />

            <!-- Correo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_login_user"
                    android:tint="@color/auth_icon" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:hint="@string/hint_email"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="@color/auth_text_primary"
                    android:textColorHint="#9892BF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Contraseña -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_login_lock"
                    android:tint="@color/auth_icon" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/auth_text_primary"
                    android:textColorHint="#9892BF"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ver_contrasena"
                    android:padding="8dp"
                    android:src="@drawable/ic_ojo_cerrado"
                    android:tint="@color/auth_icon_muted" />
            </LinearLayout>

            <!-- Recordarme y recuperación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRecordar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:button="@drawable/selector_chk_recordar"
                    android:checked="true"
                    android:fontFamily="sans-serif"
                    android:padding="0dp"
                    android:text="@string/recordar_sesion"
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Acción principal -->
            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/btn_iniciar_sesion"
                android:textAllCaps="false"
                android:textColor="@color/auth_text_on_gradient"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/linkRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="40dp"
            android:padding="8dp"
            android:text="@string/link_registro"
            android:textColor="@color/auth_text_on_gradient"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>