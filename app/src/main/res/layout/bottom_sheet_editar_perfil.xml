<?xml version="1.0" encoding="utf-8"?>

<!--
    Panel "Editar perfil": avatar (se guarda al instante, como antes) y el
    alias que el usuario quiere ver en la app.
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar perfil"
        android:textColor="#211D3B"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cambia tu avatar y el nombre que verás en la app."
        android:textColor="#8B88A8"
        android:textSize="12sp" />

    <!-- ================================================== -->
    <!-- NOMBRE VISIBLE                                    -->
    <!-- ================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input_moderno"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOMBRE VISIBLE"
            android:textColor="#6C5CE7"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreVisible"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:hint="Ej. Ana"
            android:inputType="textCapWords"
            android:maxLength="20"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#211D3B"
            android:textColorHint="#B0ACBD"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContadorNombreVisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0/20"
            android:textColor="#9A96A9"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Así te saludaremos en la pantalla principal."
        android:textColor="#918DA4"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:background="#EEEAF5" />

    <!-- ================================================== -->
    <!-- AVATAR                                            -->
    <!-- ================================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu avatar"
        android:textColor="#433E5C"
        android:textSize="12sp"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/gridAvatares"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:useDefaultMargins="true" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGuardarPerfil"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button"
        android:stateListAnimator="@null"
        android:text="Guardar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCerrarPerfil"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_button_outline"
        android:stateListAnimator="@null"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textColor="#5B4FE9"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>