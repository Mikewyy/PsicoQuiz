<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================= -->
    <!-- PERMISOS -->
    <!-- ========================================= -->

    <!-- Notificaciones Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permite reprogramar alarmas al reiniciar el dispositivo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


    <application
        android:name=".SemiologiaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PsicoQuiz"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Semiologia">


        <!-- ========================================= -->
        <!-- MULTIJUGADOR -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.estudio.QuizMultijugadorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.estudio.MultijugadorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.estudio.SalaActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- LOGIN -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ========================================= -->
        <!-- REGISTRO -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- DASHBOARD -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />


        <!-- ========================================= -->
        <!-- GUÍA DE ESTUDIO -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.estudio.GuiaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.estudio.CaminoEstudioActivity"
            android:exported="false" />

        <activity
            android:name=".ui.estudio.LectorActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- EVALUACIÓN / JUEGO -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.evaluacion.CaminoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.evaluacion.QuizActivity"
            android:exported="false" />

        <activity
            android:name=".ui.evaluacion.ResultadoActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- NOTIFICACIÓN DEL DESAFÍO DIARIO -->
        <!-- ========================================= -->

        <receiver
            android:name=".receivers.AlarmaDesafioReceiver"
            android:enabled="true"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- REPROGRAMAR ALARMAS AL REINICIAR -->
        <!-- ========================================= -->

        <receiver
            android:name=".receivers.ReinicioAlarmasReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>

                <action android:name="android.intent.action.BOOT_COMPLETED" />

                <action android:name="android.intent.action.QUICKBOOT_POWERON" />

            </intent-filter>

        </receiver>


    </application>

</manifest>