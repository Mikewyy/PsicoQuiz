<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SemiologiaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PsicoQuiz"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Semiologia">
        <!-- ========================================= -->
        <!-- POMODORO -->
        <!-- ========================================= -->
        <activity
            android:name=".ui.pomodoro.PomodoroActivity"
            android:exported="false" />

        <!-- ========================================= -->
        <!-- LOGIN -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <!-- ========================================= -->
        <!-- REGISTRO -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- DASHBOARD -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- GUÍA DE ESTUDIO -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.estudio.GuiaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.estudio.CaminoEstudioActivity"
            android:exported="false" />

        <activity
            android:name=".ui.estudio.LectorActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- EVALUACIÓN / JUEGO -->
        <!-- ========================================= -->

        <activity
            android:name=".ui.evaluacion.JugarActivity"
            android:exported="false" />

        <activity
            android:name=".ui.evaluacion.CaminoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.evaluacion.QuizActivity"
            android:exported="false" />

        <activity
            android:name=".ui.evaluacion.ResultadoActivity"
            android:exported="false" />

    </application>

</manifest>